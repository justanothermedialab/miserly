{
  "name": "@miserly/desktop",
  "private": true,
  "version": "26.11.0",
  "description": "Miserly",
  "type": "commonjs",
  "main": "main.cjs",
  "scripts": {
    "prepare:server": "node scripts/prepare-server.mjs",
    "start": "pnpm prepare:server && electron .",
    "exe": "pnpm prepare:server && electron-builder --dir",
